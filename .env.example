# Copiez ce fichier vers .env et renseignez les valeurs de votre projet Supabase.
# Ces deux variables sont obligatoires : sans elles, le build échoue.
# Sur Vercel, définissez-les dans Settings → Environment Variables.

# URL du projet Supabase (Project Settings → API → Project URL)
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co

# Clé publique « anon » (Project Settings → API → Project API keys → anon public)
VITE_SUPABASE_ANON_KEY=eyJ...
